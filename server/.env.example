PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# mysql://USER:PASSWORD@HOST:PORT/DATABASE  (use the same values as your existing MySQL setup)
# XAMPP default (user root, no password):
DATABASE_URL="mysql://root@localhost:3306/portfolio_db"
# Local classroom demo: true. Set to false on a public deployment to block create/update/delete of projects.
ALLOW_PROJECT_EDITS=true
